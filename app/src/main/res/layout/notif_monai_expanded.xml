<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp"
    android:background="@android:color/transparent">

    <!-- Header App Title & Mode Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/txt_exp_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MonAi • Focus App"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"/>
        <TextView
            android:id="@+id/txt_exp_mode_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODE: AUTO"
            android:textColor="#00F2FE"
            android:textStyle="bold"
            android:textSize="11sp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:background="#20FFFFFF"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="6dp"/>

    <!-- Grid Row 1: RAM & CPU -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- RAM Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APP RAM"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/txt_exp_ram_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="127 MB"
                android:textColor="#00F2FE"
                android:textStyle="bold"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- CPU Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU FREQ &amp; TEMP"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/txt_exp_cpu_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="633 / 1843 MHz (39.0°C)"
                android:textColor="#38BDF8"
                android:textStyle="bold"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Grid Row 2: POWER STREAM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POWER STREAM (BATTERY)"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/txt_exp_power_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-714 mA (Discharge) • 50% (39.0°C)"
            android:textColor="#F87171"
            android:textStyle="bold"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Action Buttons with Sleek Translucent Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/btn_notif_perf"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="PERF"
            android:textColor="#FF8A65"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/notif_btn_bg_perf"/>

        <TextView
            android:id="@+id/btn_notif_bal"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="BALANCED"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/notif_btn_bg_bal"/>

        <TextView
            android:id="@+id/btn_notif_save"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SAVER"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/notif_btn_bg_save"/>
    </LinearLayout>
</LinearLayout>