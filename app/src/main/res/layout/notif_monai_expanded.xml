<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="4dp"
    android:paddingBottom="6dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/txt_exp_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MonAi • Focus App"
            android:textColor="@color/notif_title_color"
            android:textStyle="bold"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/txt_exp_mode_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/notif_badge_bg"
            android:text="MODE: AUTO"
            android:textColor="@color/notif_bal_color"
            android:textStyle="bold"
            android:textSize="10sp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:background="@color/notif_divider"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/chip_ram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:background="@drawable/notif_chip_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APP RAM"
                android:textColor="@color/notif_sub_color"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>
            <TextView
                android:id="@+id/txt_exp_ram_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="127 MB"
                android:textColor="@color/notif_ram_color"
                android:textStyle="bold"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chip_cpu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical"
            android:background="@drawable/notif_chip_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU FREQ &amp; TEMP"
                android:textColor="@color/notif_sub_color"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>
            <TextView
                android:id="@+id/txt_exp_cpu_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="633 / 1843 MHz (39.0°C)"
                android:textColor="@color/notif_cpu_color"
                android:textStyle="bold"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chip_power"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:background="@drawable/notif_chip_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POWER STREAM (BATTERY)"
            android:textColor="@color/notif_sub_color"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>
        <TextView
            android:id="@+id/txt_exp_power_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="-714 mA (Discharge) • 50% (39.0°C)"
            android:textColor="@color/notif_power_discharge"
            android:textStyle="bold"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/btn_notif_perf"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="PERF"
            android:textColor="@color/notif_perf_color"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:background="@drawable/notif_btn_bg_perf"/>

        <TextView
            android:id="@+id/btn_notif_bal"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="BALANCED"
            android:textColor="@color/notif_bal_color"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:background="@drawable/notif_btn_bg_bal"/>

        <TextView
            android:id="@+id/btn_notif_save"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SAVER"
            android:textColor="@color/notif_save_color"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:background="@drawable/notif_btn_bg_save"/>
    </LinearLayout>
</LinearLayout>
