<?xml version="1.0" encoding="utf-8"?>
<!-- Rombak total v3: expanded view modern dengan battery progress bar,
     chips statistik rapi, dan tombol profil konsisten tema V2 Pastel Blue.
     Semua ID lama dipertahankan; progress_battery BARU di-set dari
     MonAiService via setProgressBar(...). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <!-- Header: title + mode badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/txt_exp_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MonProject • Focus App"
            android:textColor="@color/notif_title_color"
            android:textStyle="bold"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/txt_exp_mode_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/notif_badge_bg"
            android:text="MODE: AUTO"
            android:textColor="@color/notif_accent"
            android:textStyle="bold"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- Battery level progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BATTERY LEVEL"
            android:textColor="@color/notif_sub_color"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/progress_battery"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/notif_progress_drawable"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:background="@color/notif_divider"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"/>

    <!-- Row chips: RAM + CPU -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/chip_ram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:background="@drawable/notif_chip_bg"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FREE RAM"
                android:textColor="@color/notif_sub_color"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>
            <TextView
                android:id="@+id/txt_exp_ram_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="127 MB"
                android:textColor="@color/notif_ram_color"
                android:textStyle="bold"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chip_cpu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical"
            android:background="@drawable/notif_chip_bg"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU FREQ &amp; TEMP"
                android:textColor="@color/notif_sub_color"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>
            <TextView
                android:id="@+id/txt_exp_cpu_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="633 / 1843 MHz (39.0°C)"
                android:textColor="@color/notif_cpu_color"
                android:textStyle="bold"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Power chip full width -->
    <LinearLayout
        android:id="@+id/chip_power"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:background="@drawable/notif_chip_bg"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POWER STREAM (BATTERY)"
            android:textColor="@color/notif_sub_color"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>
        <TextView
            android:id="@+id/txt_exp_power_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="-714 mA (Discharge) • 50% (39.0°C)"
            android:textColor="@color/notif_power_discharge"
            android:textStyle="bold"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
