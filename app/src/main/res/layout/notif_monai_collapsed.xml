<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#0D1726">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/txt_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MonAi • Focus App"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"/>
        <TextView
            android:id="@+id/txt_mode_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTO"
            android:textColor="#00F2FE"
            android:textStyle="bold"
            android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <TextView
            android:id="@+id/txt_col_ram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RAM: 143MB"
            android:textColor="#00F2FE"
            android:textSize="11sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/txt_col_cpu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CPU: 1113MHz"
            android:textColor="#00C6FF"
            android:textSize="11sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/txt_col_power"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-267 mA"
            android:textColor="#FF5E36"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>