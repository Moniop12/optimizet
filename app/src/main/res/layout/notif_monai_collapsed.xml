<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/txt_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MonAi • Focus App"
            android:textColor="@color/notif_title_color"
            android:textStyle="bold"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/txt_mode_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/notif_badge_bg"
            android:text="AUTO"
            android:textColor="@color/notif_ram_color"
            android:textStyle="bold"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">
        <TextView
            android:id="@+id/txt_col_ram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RAM: 127 MB"
            android:textColor="@color/notif_ram_color"
            android:textSize="11sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/txt_col_cpu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="CPU: 633 MHz"
            android:textColor="@color/notif_cpu_color"
            android:textSize="11sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/txt_col_power"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-714 mA"
            android:textColor="@color/notif_power_discharge"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
