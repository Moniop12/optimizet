<?xml version="1.0" encoding="utf-8"?>
<!-- V4: Notifikasi 1 baris minimalis — isi: baterai + suhu + badge mode.
     Tidak makan tempat di shade notifikasi. Ketuk notifikasi = buka
     floating overlay (bukan Activity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <TextView
        android:id="@+id/txt_notif_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="78%"
        android:textColor="@color/notif_power_discharge"
        android:textSize="12sp"
        android:textStyle="bold"
        android:singleLine="true"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:text="·"
        android:textColor="@color/notif_sub_color"
        android:textSize="12sp"
        android:singleLine="true"/>

    <TextView
        android:id="@+id/txt_notif_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="36.5°C"
        android:textColor="@color/notif_title_color"
        android:textSize="12sp"
        android:textStyle="bold"
        android:singleLine="true"/>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:id="@+id/txt_notif_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/notif_badge_bg"
        android:text="BALANCED"
        android:textColor="@color/notif_accent"
        android:textStyle="bold"
        android:textSize="9sp"
        android:singleLine="true"/>
</LinearLayout>
