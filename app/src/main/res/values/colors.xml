<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light Mode Notification Colors — monokrom, netral. Warna dipakai
         HANYA untuk arti (charging=hijau redup, discharge=merah redup),
         bukan tiap metrik dapat warna berbeda seperti sebelumnya. -->
    <color name="notif_title_color">#1C1C1E</color>
    <color name="notif_sub_color">#6E6E73</color>
    <color name="notif_ram_color">#3A3A3C</color>
    <color name="notif_cpu_color">#3A3A3C</color>
    <color name="notif_power_discharge">#B23B3E</color>
    <color name="notif_power_charge">#3D7A56</color>

    <!-- Button backgrounds: satu gaya netral, state aktif dibedakan via
         tonal fill tipis (bukan warna solid berbeda per tombol). -->
    <color name="notif_btn_perf_bg">#0F1C1C1E</color>
    <color name="notif_btn_bal_bg">#0F1C1C1E</color>
    <color name="notif_btn_save_bg">#0F1C1C1E</color>
    <color name="notif_btn_active_bg">#1A1C1C1E</color>

    <color name="notif_badge_bg">#0A1C1C1E</color>
    <color name="notif_divider">#14000000</color>
</resources>
