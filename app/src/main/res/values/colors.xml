         (yg dipakai di atas dasar gelap) karena di sini backgroundnya putih. -->
    <color name="notif_title_color">#1A1B20</color>
    <color name="notif_sub_color">#6B7280</color>
    <color name="notif_ram_color">#4C5FE0</color>
    <color name="notif_cpu_color">#4C5FE0</color>
    <color name="notif_power_discharge">#E0313F</color>
    <color name="notif_power_charge">#12A15C</color>
    <color name="notif_perf_color">#DB7A1E</color>
    <color name="notif_bal_color">#4C5FE0</color>
    <color name="notif_save_color">#12A15C</color>

    <color name="notif_btn_perf_bg">#1EDB7A1E</color>
    <color name="notif_btn_bal_bg">#1E4C5FE0</color>
    <color name="notif_btn_save_bg">#1E12A15C</color>
    <color name="notif_btn_perf_active_bg">#DB7A1E</color>
    <color name="notif_btn_bal_active_bg">#4C5FE0</color>
