<?xml version="1.0" encoding="utf-8"?>
<!-- Progress bar aksen pastel blue (V2 theme) untuk notifikasi expanded.
     Layer-list: background = track lembut, progress = aksen notif_accent. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="3dp"/>
            <solid android:color="@color/notif_progress_track"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="3dp"/>
                <solid android:color="@color/notif_accent"/>
            </shape>
        </clip>
    </item>
</layer-list>
